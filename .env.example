# Firebase web app configuration - copy this file to `.env` and fill in the real values.
# Firebase console -> Project settings -> General -> Your apps -> Web app -> firebaseConfig
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firestore rules required for this app (no auth is used):
